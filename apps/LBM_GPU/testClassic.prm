DomainSetup
{
    domainSize    < 140, 90, 45>;

    loadSnapshot            0;
    storeSnapshot           0;
    snapshotFrequency       1870600;
    snapshotBaseFolder snapsnap;
    snapshotConfigFile config.snap;
    welfordFile welford.snap;
    snapshotBlockforestFile blockForest.snap;
    snapshotPdfFile pdfs.snap;
    snapshotForceFile forces.snap;
    snapshotMeanVelFile meanU.snap;
    snapshotSOPFile SOP.snap;

}

Parameters
{
    timesteps              550;
    concurrentStart        499;

    length_SI              0.15;
    length_LU              15;

    velocity_SI            2.5;
    velocity_LU            0.05773502691896259;

    viscosity_SI           1.82e-05;
    density_SI             1.225;

    gaussianSigma     2.0;

    useGui 0;
    remainingTimeLoggerFrequency 5; // in seconds

    innerOuterSplit < 8, 1, 1>;     // slice-thickness that 'outer'-kernels process when overlapping
    gpuBlockSize < 64, 1, 1>;

    referenceHeight_LU 12.5;
    samplingHeight_LU  8;

    roughnessLengthRatio 6.667e-05;                // z0 / zHub / C_l
    kappa 0.42;
}

Initialisation {
    type asmuth;
    initialVelocity <0.05773502691896259, 0, 0>;
}

Boundaries
{
    setup                   Open;

    inflowType              Periodic;
    outflowType             Periodic;

    wallType NoSlip;
}

WindFarm{
/*
    Turbine1
	{
	    basePoint             <67.5,45.0,0.0>;
	    diameter_LU             15;
	    hubRotationalVelocity       <0,0,117.28612573401894>;
	    towerDescription   GWS.tower;
	    bladeDescription   GWS.blade;
	    towerEffect     0;
	    nacelleEffect   1;
	    tipLoss         1;
	    nPointsBlades   20;
	    nPointsTower    2;
	    nBlades         3;
	    nacelleYaw      0.0;
	    hubRadius_SI    0.005;
	    hubDeport_SI    0.0;
	    hubTilt         0.0;
	    bladePitch      0.0;
	    bladePrecone    0.0;
	    aeroModel       actuatorLine;
	    rotorDrag       0.8248;
	}
*/
}

Output{

    welfordIntervalOutput 25;

    VTK
    {
        writeFrequency 25;
        ghostLayers    0;

        baseFolder           GPU_Precursor_vtk_out;
        executionFolder      simulation_step;

        inclusion_filters {
            combine{
                Plane {
                    point <0,45,0>;
                    normal <0,1,0>;
                    maxDistance 1;
                }
                AABB {
                    min <0,0,0>;
                    max <540,90,45>;
                }
            }

            combine{
                Plane {
                    point <0,0,12.5>;
                    normal <0,0,1>;
                    maxDistance 1;
                }
                AABB {
                    min <0,0,0>;
                    max <540,90,45>;
                }
            }

            combine{
                Plane {
                    point <68,0,0>;
                    normal <1,0,0>;
                    maxDistance 1;
                }
                AABB {
                    min <0,0,0>;
                    max <540,90,45>;
                }
            }
        }

        fields {
            Velocity;
            Force;
        }

        // writeFlagField  1;
        //writeDomainDecomposition;
    }
}
}
